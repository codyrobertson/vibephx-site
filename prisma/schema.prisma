// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id        String   @id // No @default - must use Stack Auth ID explicitly
  email     String   @unique
  name      String?
  image     String?

  // Credits system
  creditsBalance Float @default(0) // Dollar amount of credits

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects           Project[]
  profile            UserProfile?
  workshopAttendance WorkshopAttendance[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  
  // Onboarding data
  skillLevel        String?  // 'beginner', 'intermediate', 'advanced'
  interests         String[] // e.g., ['saas', 'ecommerce', 'ai-tools', 'dashboards']
  primaryGoal       String?  // 'learn', 'side-project', 'startup', 'client-work'
  timeCommitment    String?  // '1-day', '1-week', '1-month'
  techPreferences   String[] // e.g., ['react', 'nextjs', 'python']
  hasTeam           Boolean  @default(false)
  preferredComplexity String? // 'simple', 'moderate', 'complex'
  
  onboardingCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

model Project {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String?

  // Project configuration
  template   String?
  customIdea String?
  techStack  Json? // Store selected tech stack

  // Generation status and results
  status           ProjectStatus @default(DRAFT)
  generated        Json? // Store generated documents
  completedAt      DateTime?
  prdCount         Int           @default(0)
  lastPRDAt        DateTime?
  prdGeneratedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prdSessions PRDSession[]
  llmLogs     LLMLog[]
  documents   ProjectDocument[]

  @@index([userId, status, updatedAt])
  @@map("projects")
}

model PRDSession {
  id        String  @id @default(cuid())
  userId    String
  projectId String?

  // Coach Bot state snapshot
  initialIntent String
  audience      String?
  motivation    String?
  sda           String?

  featuresRaw     String[]
  featuresMvp     String[]
  featuresStretch String[]

  dbChoice      String?
  selectedStack String?
  integrations  String[]

  // Generated outputs
  prdMarkdown        String?
  eightLinePrompt    String?
  acceptanceCriteria String[]
  prdGeneratedAt     DateTime?

  // Tech stack details (AI-generated, project-specific)
  techStackDetails   Json?    // Cached bespoke tech explanations

  // Metadata
  phase       String   @default("intro")
  messages    Json     @default("[]")
  completed   Boolean  @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, completed, updatedAt])
  @@map("prd_sessions")
}

model LLMLog {
  id        String  @id @default(cuid())
  userId    String
  projectId String?
  sessionId String?

  // Request details
  model            String // e.g., "anthropic/claude-3.5-sonnet"
  provider         String // e.g., "openrouter", "openai"
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  // Cost tracking
  costUsd Float?

  // Context
  purpose  String // e.g., "feature_suggestions", "autofill_audience"
  prompt   String  @db.Text
  response String? @db.Text

  // Performance
  durationMs   Int?
  success      Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([userId, costUsd])
  @@map("llm_logs")
}

model Generation {
  id        String  @id @default(cuid())
  userId    String
  projectId String?

  // Generation details
  type     GenerationType
  prompt   String
  result   String
  metadata Json? // Store additional data like token usage, model used, etc.

  // Status
  status GenerationStatus @default(COMPLETED)
  error  String?

  createdAt DateTime @default(now())

  @@map("generations")
}

enum ProjectStatus {
  DRAFT
  GENERATING
  COMPLETED
  ERROR
}

enum GenerationType {
  PRD
  BUILD_DOC
  UI_SPECS
  DATA_MODELS
  TASK_LIST
  MARKETING_GUIDE
  CLAUDE_MD
  CURSOR_RULES
  STACK_SUGGESTION
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  PRD
  BUILD_DOC
  CODE
  SPEC
  GUIDE
  MARKDOWN
  TEXT
  ARTIFACT
  OTHER
}

model ProjectDocument {
  id        String  @id @default(cuid())
  projectId String
  userId    String

  // Document metadata
  type        DocumentType
  title       String
  content     String       @db.Text
  excerpt     String?      @db.VarChar(250) // First 200-250 chars for preview

  // Embedding for semantic search (1536 dimensions for text-embedding-3-small)
  embedding   Unsupported("vector(1536)")?

  // Artifact tracking
  isBookmarked Boolean   @default(false)
  bookmarkedAt DateTime?
  generatedBy  String?   // AI model used

  // Metadata
  tags        String[]
  metadata    Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions    DocumentVersion[]

  @@index([projectId, isBookmarked])
  @@index([userId, isBookmarked])
  @@index([type])
  @@map("project_documents")
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  userId     String

  // Version tracking
  version        Int      // Auto-incremented version number
  content        String   @db.Text
  title          String
  changeMessage  String?  @db.VarChar(500)

  // Metadata
  createdBy      String?  // Name/email of user who created this version
  restoredFrom   Int?     // If this was restored from another version, track which one

  createdAt      DateTime @default(now())

  // Relations
  document       ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

model Workshop {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  credits     Float    @default(20) // Credits awarded per attendance
  files       Json?    // Array of {name, url, size, type, uploadedAt}

  // Customizable content
  content     String?  @db.Text // Rich content about the workshop
  headerImage String?  @db.Text // Header image URL or base64

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  attendees   WorkshopAttendance[]

  @@index([date])
  @@index([createdAt])
  @@map("workshops")
}

model WorkshopAttendance {
  id          String   @id @default(cuid())
  userId      String
  workshopId  String

  // Credits tracking
  creditsAwarded Float
  creditsApplied Boolean @default(false) // Track if credits were added to user balance

  // Email tracking
  emailSentAt    DateTime?
  emailOpenedAt  DateTime?
  emailClickedAt DateTime?

  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, workshopId]) // User can only attend each workshop once
  @@index([userId])
  @@index([workshopId])
  @@map("workshop_attendance")
}
