// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects Project[]
  profile  UserProfile?

  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  
  // Onboarding data
  skillLevel        String?  // 'beginner', 'intermediate', 'advanced'
  interests         String[] // e.g., ['saas', 'ecommerce', 'ai-tools', 'dashboards']
  primaryGoal       String?  // 'learn', 'side-project', 'startup', 'client-work'
  timeCommitment    String?  // '1-day', '1-week', '1-month'
  techPreferences   String[] // e.g., ['react', 'nextjs', 'python']
  hasTeam           Boolean  @default(false)
  preferredComplexity String? // 'simple', 'moderate', 'complex'
  
  onboardingCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

model Project {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String?

  // Project configuration
  template   String?
  customIdea String?
  techStack  Json? // Store selected tech stack

  // Generation status and results
  status    ProjectStatus @default(DRAFT)
  generated Json? // Store generated documents

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prdSessions PRDSession[]
  llmLogs     LLMLog[]

  @@map("projects")
}

model PRDSession {
  id        String  @id @default(cuid())
  userId    String
  projectId String?

  // Coach Bot state snapshot
  initialIntent String
  audience      String?
  motivation    String?
  sda           String?

  featuresRaw     String[]
  featuresMvp     String[]
  featuresStretch String[]

  dbChoice      String?
  selectedStack String?
  integrations  String[]

  // Generated outputs
  prdMarkdown        String?
  eightLinePrompt    String?
  acceptanceCriteria String[]

  // Metadata
  phase     String  @default("intro")
  messages  Json    @default("[]")
  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("prd_sessions")
}

model LLMLog {
  id        String  @id @default(cuid())
  userId    String
  projectId String?
  sessionId String?

  // Request details
  model            String // e.g., "anthropic/claude-3.5-sonnet"
  provider         String // e.g., "openrouter", "openai"
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  // Cost tracking
  costUsd Float?

  // Context
  purpose  String // e.g., "feature_suggestions", "autofill_audience"
  prompt   String  @db.Text
  response String? @db.Text

  // Performance
  durationMs   Int?
  success      Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId])
  @@map("llm_logs")
}

model Generation {
  id        String  @id @default(cuid())
  userId    String
  projectId String?

  // Generation details
  type     GenerationType
  prompt   String
  result   String
  metadata Json? // Store additional data like token usage, model used, etc.

  // Status
  status GenerationStatus @default(COMPLETED)
  error  String?

  createdAt DateTime @default(now())

  @@map("generations")
}

enum ProjectStatus {
  DRAFT
  GENERATING
  COMPLETED
  ERROR
}

enum GenerationType {
  PRD
  BUILD_DOC
  UI_SPECS
  DATA_MODELS
  TASK_LIST
  MARKETING_GUIDE
  CLAUDE_MD
  CURSOR_RULES
  STACK_SUGGESTION
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
